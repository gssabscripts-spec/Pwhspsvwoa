-- Noclip with collision restoration
local function RestoreCollisions()
    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end

    if DescendantConnection then
        DescendantConnection:Disconnect()
        DescendantConnection = nil
    end

    for part, original in pairs(OriginalCollision) do
        if part and part.Parent then
            part.CanCollide = original
        end
    end

    table.clear(OriginalCollision)
end

local function TrackPart(part)
    if not Noclip or not part:IsA("BasePart") then
        return
    end

    if OriginalCollision[part] == nil then
        OriginalCollision[part] = part.CanCollide
    end

    part.CanCollide = false
end

local function SetNoclip(enabled)
    Noclip = enabled
    RestoreCollisions()

    if not enabled then
        return
    end

    local char = Character()
    if not char then
        return
    end

    for _, part in ipairs(char:GetDescendants()) do
        TrackPart(part)
    end

    DescendantConnection = char.DescendantAdded:Connect(TrackPart)

    NoclipConnection = RunService.Stepped:Connect(function()
        local current = Character()
        if Noclip and current then
            for _, part in ipairs(current:GetDescendants()) do
                TrackPart(part)
            end
        end
    end)
end

-- Flotation
local function StopFlotation()
    UpHeld = false
    DownHeld = false

    if FloatConnection then
        FloatConnection:Disconnect()
        FloatConnection = nil
    end

    if FloatVelocity then
        FloatVelocity:Destroy()
        FloatVelocity = nil
    end

    if FloatGui then
        FloatGui:Destroy()
        FloatGui = nil
    end
end

local function HoldButton(parent, text, y, onDown, onUp)
    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(62, 56)
    button.Position = UDim2.fromOffset(8, y)
    button.BackgroundColor3 = Color3.fromRGB(25, 32, 48)
    button.Text = text
    button.TextColor3 = Color3.fromRGB(180, 125, 255)
    button.TextSize = 25
    button.Font = Enum.Font.GothamBold
    button.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 14)
    corner.Parent = button

    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            onDown()
        end
    end)

    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            onUp()
        end
    end)

    return button
end

local function StartFlotation()
    StopFlotation()

    local root = Root()
    if not root or not Humanoid() then
        return
    end

    FloatGui = Instance.new("ScreenGui")
    FloatGui.Name = "GSSABFlotation"
    FloatGui.ResetOnSpawn = false
    FloatGui.DisplayOrder = 20
    FloatGui.Parent = PlayerGui

    local panel = Instance.new("Frame")
    panel.Size = UDim2.fromOffset(78, 138)
    panel.Position = UDim2.new(1, -94, 0.5, -69)
    panel.BackgroundColor3 = Color3.fromRGB(13, 18, 30)
    panel.Parent = FloatGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 18)
    corner.Parent = panel

    HoldButton(panel, "▲", 8,
        function() UpHeld = true end,
        function() UpHeld = false end
    )

    HoldButton(panel, "▼", 74,
        function() DownHeld = true end,
        function() DownHeld = false end
    )

    FloatVelocity = Instance.new("BodyVelocity")
    FloatVelocity.Name = "GSSABFloatVelocity"
    FloatVelocity.MaxForce = Vector3.new(0, 1000000, 0)
    FloatVelocity.P = 15000
    FloatVelocity.Velocity = Vector3.zero
    FloatVelocity.Parent = root

    FloatConnection = RunService.Heartbeat:Connect(function()
        if not FloatVelocity or not FloatVelocity.Parent then
            return
        end

        local speed = 0
        if UpHeld and not DownHeld then
            speed = FloatSpeed
        elseif DownHeld and not UpHeld then
            speed = -FloatSpeed
        end

        FloatVelocity.Velocity = Vector3.new(0, speed, 0)
    end)
end

